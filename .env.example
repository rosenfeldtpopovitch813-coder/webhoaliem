# Firebase Web SDK (public identifiers, safe for browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend only (never prefix these with VITE_)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or use FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY

# AI Tutor server-only (never prefix with VITE_)
# GEMINI_API_KEY=your_google_ai_studio_api_key
# GEMINI_MODEL=gemini-3.8-flash

# Required server-side for Firebase Admin operations / AI quota storage.
# Use the EXACT Realtime Database URL from Firebase Console → Realtime Database → Data.
# Set this variable in Vercel for Production and Preview, alongside the VITE version above.
# FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
