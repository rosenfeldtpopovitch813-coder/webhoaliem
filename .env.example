# Backend only: never publish this file with real values or commit a service account.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Configure one AI provider only when the assistant is needed. Keep keys server-side.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional support contact used by Theme Store. Never expose secrets here.
ZALO_SUPPORT_URL=
ZALO_SUPPORT_LABEL=Liên hệ hỗ trợ qua Zalo
ZALO_SUPPORT_QR_URL=
